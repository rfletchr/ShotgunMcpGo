SG_SITE_URL=https://yoursite.shotgunstudio.com
SG_SCRIPT_NAME=your-script-name
SG_SCRIPT_KEY=your-script-key

# sg_find_csv output: an EXISTING absolute host directory, bind-mounted at /exports.
# Create it first (docker would create a missing one owned by root).
SG_EXPORT_HOST_DIR=/absolute/path/to/exports
# uid:gid the container runs as (`id -u` / `id -g`), so exported files are yours.
SG_EXPORT_UID=1000
SG_EXPORT_GID=1000
